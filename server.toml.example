host = "0.0.0.0"
port = 8765
api_token = "change-me-in-production"
data_dir = "./data"
projects_dir = "./projects"
project_templates_dir = "./project-templates"
log_level = "info"

# Optional extra tokens. The legacy api_token above is always treated as admin.
# Use read for read-only API clients, agent for MCP/coding agents, and admin
# for dashboard login or full API access.
#
# [[tokens]]
# name = "readonly"
# token = "replace-with-readonly-token"
# scopes = ["read"]
#
# [[tokens]]
# name = "agent"
# token = "replace-with-agent-token"
# scopes = ["agent"]
#
# [[tokens]]
# name = "admin-dashboard"
# token = "replace-with-admin-token"
# scopes = ["admin"]

# Optional lifecycle webhooks. Requests are signed with
# X-IssueDeck-Signature: sha256=<hmac>, delivered asynchronously, and retried
# without blocking the item mutation.
#
# [[webhooks]]
# name = "automation"
# url = "https://example.com/hooks/issuedeck"
# secret = "replace-with-a-long-random-secret"
# events = ["item.created", "item.updated", "item.shipped", "item.deleted", "item.restored"]
# retries = 3
# timeout_seconds = 5
# backoff_seconds = 0.5

# Optional team notifications. These are plain chat messages delivered through
# Slack or Discord incoming webhook URLs. Use signed lifecycle webhooks above
# when another system needs a verifiable machine-readable payload.
#
# [[notifications]]
# name = "team-alerts"
# provider = "slack"
# url = "https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXX"
# events = ["item.created", "item.shipped"]
# retries = 3
# timeout_seconds = 5
# backoff_seconds = 0.5
#
# [[notifications]]
# name = "release-room"
# provider = "discord"
# url = "https://discord.com/api/webhooks/1234567890/replace-with-token"
# events = ["item.shipped"]

[sqlite]
wal_mode = true
busy_timeout_ms = 5000
